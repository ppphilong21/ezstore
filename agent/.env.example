# agent/.env — used when the agent runs on your machine
# (agents-cli playground / agents-cli run / agents-cli eval / scripts/grading/grade_agent.py).
# Inside Docker Compose these values come from the root .env instead.
# .env is git-ignored: never commit real keys.

# --- Model credentials (pick one) ---
# A. Google AI Studio API key (recommended, free tier is enough): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# B. Vertex AI (run `gcloud auth application-default login` first)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id   (replace local-only below)
# GOOGLE_CLOUD_LOCATION=global

# agents-cli 1.9/1.10 `eval run` refuses to grade without a project id, even with an AI Studio key.
# A placeholder is enough (it is NOT used to call Vertex unless GOOGLE_GENAI_USE_VERTEXAI=true).
GOOGLE_CLOUD_PROJECT=local-only

# agents-cli eval always creates a Cloud Storage client, which requires Application Default
# Credentials to exist. Without gcloud, point at this placeholder (path relative to agent/).
GOOGLE_APPLICATION_CREDENTIALS=tests/eval/adc-placeholder.json
# Skip ADK's mTLS probe for MCP (not used locally).
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# --- Model ---
AGENT_MODEL=gemini-3.8-flash
# Optional: a different model for the eval LLM judges. Each model has its own free-tier quota,
# so this halves the requests per model during grading. Empty = same as AGENT_MODEL.
JUDGE_MODEL=
# Optional: give each judge its own model (each model has its own daily quota). Empty = JUDGE_MODEL.
REFUSAL_JUDGE_MODEL=
QUALITY_JUDGE_MODEL=

# --- MCP Server: the port Docker Compose exposes on your machine (8000 is often taken) ---
MCP_URL=http://localhost:8010/mcp

# --- Links in replies point at the frontend ---
FRONTEND_URL=http://localhost:3000
