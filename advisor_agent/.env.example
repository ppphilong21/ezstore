# advisor_agent/.env — only for running the advisor on your machine (Docker Compose uses the root .env).
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
AGENT_MODEL=gemini-3.8-flash
# The quotation agent's A2A endpoint. Locally, run it with:
#   cd agent && APP_URL=http://localhost:8081 uv run uvicorn quotation_agent.fast_api_app:app --port 8081
QUOTATION_AGENT_A2A_URL=http://localhost:8081/a2a/quotation_agent
BACKEND_URL=http://localhost:8080
# OKF_BUNDLE defaults to ../knowledge/ezstore-okf
